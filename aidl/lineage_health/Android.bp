cc_binary {
    name: "vendor.lineage.health-service.samsung",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.health-service.samsung.rc"],
    vintf_fragments: ["vendor.lineage.health-service.samsung.xml"],
    cflags: select(soong_config_variable("samsungHealthVars", "charging_control_supports_bypass"), {
        false: [],
        default: ["-DHEALTH_CHARGING_CONTROL_SUPPORTS_BYPASS"],
    }) + select(soong_config_variable("samsungHealthVars", "charging_control_supports_limit"), {
        true: ["-DHEALTH_CHARGING_CONTROL_SUPPORTS_LIMIT"],
        default: [],
    }),
    srcs: [
        "service.cpp",
        "ChargingControl.cpp",
        "FastCharge.cpp",
        "WirelessFastCharge.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.lineage.health-V3-ndk",
    ],
}
